{
  "manifest_version": 3,
  "name": "VK Music Downloader",
  "version": "1.0.0",
  "description": "Добавляет кнопку скачивания рядом с каждым треком на vk.ru: mp3 с названием, исполнителем и обложкой.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://vk.ru/*", "https://vk.com/*"],
      "js": ["src/unmask.js", "src/hls.js", "src/main.js"],
      "css": ["src/style.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
